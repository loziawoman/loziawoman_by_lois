# Copy to .env.local for local development. Never commit real values.
# Only NEXT_PUBLIC_ variables are visible to the browser.

# --- Supabase (Project Settings > API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Site --------------------------------------------------------------------
# Public address of the site, used for canonical links, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN

# --- Scheduled job -----------------------------------------------------------
# Random secret. Vercel Cron sends it as "Authorization: Bearer <value>" to /api/cron/release-reservations.
CRON_SECRET=

# --- Analytics (optional) ----------------------------------------------------
# none | console | plausible
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
