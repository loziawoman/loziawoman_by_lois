'use client';
import { WishlistButton } from "@/components/wishlist/wishlist-button";

import { useEffect, useMemo, useState } from 'react';
import Link from 'next/link';
import { useRouter } from 'next/navigation';
import { Minus, Plus } from 'lucide-react';
import { GarmentColorizer } from '@/components/garment-colorizer';
import { LoziaImage } from '@/components/lozia-image';
import { useCart } from '@/hooks/use-cart';
import { track } from '@/lib/analytics';
import { MAX_LINE_QUANTITY } from '@/lib/cart/cart';
import { naira } from '@/lib/format';
import { stockStatus } from '@/lib/inventory/stock';
import { findVariant, initialSelection, isColourAvailable, isPurchasable, isSizeAvailable, selectColour } from '@/lib/products/variants';
import type { Product } from '@/types';

export function ProductView({ product, initialColour }: { product: Product; initialColour?: string }) {
  const router = useRouter();
  const cart = useCart();
  const requested = product.colours.find((c) => c.slug === initialColour)?.id;
  const [selection, setSelection] = useState(() => initialSelection(product.variants, product.colours, product.sizes, requested));
  const [imageId, setImageId] = useState(product.images[0]?.id ?? '');
  const [quantity, setQuantity] = useState(1);

  const colour = product.colours.find((c) => c.id === selection.colourId);
  const size = product.sizes.find((s) => s.id === selection.sizeId);
  const variant = useMemo(() => findVariant(product.variants, selection.colourId, selection.sizeId), [product.variants, selection]);
  const image = product.images.find((i) => i.id === imageId) ?? product.images[0];
  const original = product.colours.find((c) => c.id === product.originalColourId);
  const purchasable = isPurchasable(variant);
  const status = variant ? stockStatus(variant.available) : { kind: 'out' as const, label: 'Unavailable' };
  const maxQuantity = Math.min(MAX_LINE_QUANTITY, variant?.available ?? 1);
  const price = variant?.price ?? product.basePrice;

  useEffect(() => { track({ name: 'product_viewed', props: { slug: product.slug } }); }, [product.slug]);
  useEffect(() => { setQuantity((q) => Math.min(q, Math.max(1, maxQuantity))); }, [maxQuantity]);

  const addToBag = () => {
    if (!purchasable || !colour || !size) return false;
    cart.add({
      variantId: variant.id, productId: product.id, slug: product.slug, name: product.name, colourName: colour.name, sizeName: size.name,
      unitPrice: variant.price, quantity, image: product.images[0]?.src ?? '',
    });
    track({ name: 'add_to_cart', props: { slug: product.slug, quantity } });
    return true;
  };

  return (
    <div className="grid gap-10 md:grid-cols-[1.1fr_.9fr] md:gap-16">
      <div>
        <div className="relative aspect-[4/5] overflow-hidden bg-[hsl(var(--muted))]">
          {image && colour && original ? (
            <GarmentColorizer
              src={image.src} target={colour.hex} original={original.name} originalHex={original.hex}
              alt={`${image.alt}${colour ? `, in ${colour.name}` : ''}`} className="h-full w-full object-cover" mask={image.maskSrc ?? undefined}
            />
          ) : (
            <LoziaImage src={image?.src} alt={image?.alt ?? product.name} fill sizes="(min-width: 768px) 55vw, 100vw" loading="eager" className="object-cover" />
          )}
        </div>
        {product.images.length > 1 && (
          <ul className="mt-3 grid grid-cols-5 gap-2" aria-label="Product images">
            {product.images.map((thumb) => (
              <li key={thumb.id}>
                <button type="button" onClick={() => setImageId(thumb.id)} aria-label={`Show image: ${thumb.alt}`} aria-pressed={thumb.id === image?.id}
                  className={`relative block aspect-square w-full overflow-hidden border-2 ${thumb.id === image?.id ? 'border-[hsl(var(--foreground))]' : 'border-transparent'}`}>
                  <LoziaImage src={thumb.src} alt="" fill sizes="96px" className="object-cover" />
                </button>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div className="md:pt-6">
        <span className="mono text-[hsl(var(--accent))]">{product.category?.name}</span>
        <h1 className="serif mt-3 text-5xl md:text-6xl">{product.name}</h1>
        <div className="mt-4 flex items-center gap-4">
          <p className="text-xl" data-testid="text-price">{naira(price)}</p>
          <WishlistButton
            productId={product.id}
            slug={product.slug}
            className="h-10 w-10 border border-[hsl(var(--border))] bg-[hsl(var(--card))]"
          />
        </div>

        {product.shortDescription && <p className="mt-5 text-sm leading-7 text-[hsl(var(--muted-foreground))]">{product.shortDescription}</p>}

        <fieldset className="mt-8">
          <legend className="mono">Colour: <span className="text-[hsl(var(--muted-foreground))]">{colour?.name}</span></legend>
          <div className="mt-3 flex flex-wrap gap-3" role="radiogroup" aria-label="Colour">
            {product.colours.map((c) => {
              const available = isColourAvailable(product.variants, c.id);
              const selected = c.id === selection.colourId;
              return (
                <button
                  key={c.id} type="button" role="radio" aria-checked={selected}
                  aria-label={available ? c.name : `${c.name}, sold out`}
                  onClick={() => { setSelection(selectColour(product.variants, product.sizes, selection, c.id)); track({ name: 'colour_selected', props: { slug: product.slug, colour: c.slug } }); }}
                  className={`relative h-11 w-11 rounded-full border-2 p-1 ${selected ? 'border-[hsl(var(--foreground))]' : 'border-transparent'}`}
                  data-testid={`swatch-${c.slug}`}
                >
                  <span className={`block h-full w-full rounded-full border border-[hsl(var(--border))] ${available ? '' : 'opacity-40'}`} style={{ background: c.hex }} />
                  {!available && <span aria-hidden="true" className="absolute left-1/2 top-1 h-[calc(100%-0.5rem)] w-px rotate-45 bg-[hsl(var(--foreground))]" />}
                </button>
              );
            })}
          </div>
        </fieldset>

        <fieldset className="mt-7">
          <div className="flex items-baseline justify-between">
            <legend className="mono">Size</legend>
            <Link href="/size-guide" className="text-xs underline-link" data-testid="link-size-guide">Size guide</Link>
          </div>
          <div className="mt-3 flex flex-wrap gap-2" role="radiogroup" aria-label="Size">
            {product.sizes.map((s) => {
              const available = isSizeAvailable(product.variants, selection.colourId, s.id);
              const selected = s.id === selection.sizeId;
              return (
                <button
                  key={s.id} type="button" role="radio" aria-checked={selected} disabled={!available}
                  aria-label={available ? s.name : `${s.name}, sold out in ${colour?.name}`}
                  onClick={() => { setSelection({ ...selection, sizeId: s.id }); track({ name: 'size_selected', props: { slug: product.slug, size: s.name } }); }}
                  className={`h-11 min-w-12 border px-4 text-sm ${selected ? 'border-[hsl(var(--primary))] bg-[hsl(var(--primary))] text-[hsl(var(--primary-foreground))]' : 'border-[hsl(var(--border))]'} disabled:cursor-not-allowed disabled:text-[hsl(var(--muted-foreground))]/50 disabled:line-through`}
                  data-testid={`size-${s.name}`}
                >
                  {s.name}
                </button>
              );
            })}
          </div>
        </fieldset>

        <p className={`mt-5 text-sm ${status.kind === 'low' ? 'text-[hsl(var(--accent))]' : ''}`} role="status" data-testid="text-stock">
          <span aria-hidden="true">{status.kind === 'out' ? '✕ ' : status.kind === 'low' ? '! ' : '✓ '}</span>{status.label}
        </p>

        <div className="mt-6 flex items-center gap-4">
          <div className="flex items-center border border-[hsl(var(--border))]">
            <button type="button" onClick={() => setQuantity((q) => Math.max(1, q - 1))} className="flex h-12 w-12 items-center justify-center" aria-label="Decrease quantity"><Minus size={15} /></button>
            <span className="w-10 text-center text-sm" aria-live="polite" data-testid="text-quantity">{quantity}</span>
            <button type="button" onClick={() => setQuantity((q) => Math.min(maxQuantity, q + 1))} disabled={!purchasable || quantity >= maxQuantity} className="flex h-12 w-12 items-center justify-center disabled:opacity-30" aria-label="Increase quantity"><Plus size={15} /></button>
          </div>
          <button type="button" onClick={addToBag} disabled={!purchasable} className="h-12 flex-1 border border-[hsl(var(--primary))] px-6 mono transition-colors hover:bg-[hsl(var(--primary))] hover:text-[hsl(var(--primary-foreground))] disabled:opacity-40 disabled:hover:bg-transparent disabled:hover:text-inherit" data-testid="button-add-to-bag">
            {purchasable ? 'Add to bag' : 'Unavailable'}
          </button>
        </div>
        <button type="button" onClick={() => { if (addToBag()) { cart.setOpen(false); router.push('/checkout'); } }} disabled={!purchasable} className="mt-3 h-12 w-full bg-[hsl(var(--primary))] px-6 mono text-[hsl(var(--primary-foreground))] disabled:opacity-40" data-testid="button-buy-now">
          Buy now
        </button>

        <div className="mt-10 divide-y divide-[hsl(var(--border))] border-y border-[hsl(var(--border))]">
          {product.description && <details className="py-4" open><summary className="mono min-h-11 cursor-pointer">Description</summary><p className="mt-3 text-sm leading-7 text-[hsl(var(--muted-foreground))]">{product.description}</p></details>}
          {(product.fabric || product.care) && (
            <details className="py-4"><summary className="mono min-h-11 cursor-pointer">Fabric &amp; care</summary>
              <dl className="mt-3 grid gap-2 text-sm text-[hsl(var(--muted-foreground))]">
                {product.fabric && <div><dt className="mono">Fabric</dt><dd>{product.fabric}</dd></div>}
                {product.care && <div><dt className="mono">Care</dt><dd>{product.care}</dd></div>}
              </dl>
            </details>
          )}
          <details className="py-4"><summary className="mono min-h-11 cursor-pointer">Delivery</summary><p className="mt-3 text-sm leading-7 text-[hsl(var(--muted-foreground))]">Delivery is charged separately and shown at checkout. See our <Link href="/shipping" className="underline-link">shipping information</Link> for areas and timings.</p></details>
          <details className="py-4"><summary className="mono min-h-11 cursor-pointer">Returns</summary><p className="mt-3 text-sm leading-7 text-[hsl(var(--muted-foreground))]">Read our <Link href="/returns" className="underline-link">returns information</Link> before you order.</p></details>
        </div>
      </div>
    </div>
  );
}
