# Copy to .env.local for local development. Never commit real values.
# Only NEXT_PUBLIC_ variables are visible to the browser.

# --- Supabase (Project Settings > API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Site --------------------------------------------------------------------
# Public address of the production site, used for canonical links and social sharing metadata.
# Set this to the exact public domain customers share, e.g. https://loziawoman.com
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN

# --- Scheduled job -----------------------------------------------------------
# Random secret. Vercel Cron sends it as "Authorization: Bearer <value>" to /api/cron/release-reservations.
CRON_SECRET=

# --- Analytics (optional) ----------------------------------------------------
# none | console | plausible
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Email notifications (Resend) -------------------------------------------
# Server-only. Create an API key in Resend and use a verified sender/domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=LOZIA <hello@your-verified-domain.com>
